<?xml version="1.0" encoding="utf-8"?>
<!--
  Production network policy: cleartext (HTTP) traffic is blocked app-wide.
  All API traffic runs over HTTPS; if a specific host ever needs an
  exception, add a domain-config entry here instead of opening cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>