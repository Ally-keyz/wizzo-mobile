<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules (Android 12+). Auth tokens in shared preferences are
  excluded from both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="sharedpref" path="FlutterSecurePreferences.xml" />
        <exclude domain="cache" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="sharedpref" path="FlutterSecurePreferences.xml" />
        <exclude domain="cache" />
    </device-transfer>
</data-extraction-rules>