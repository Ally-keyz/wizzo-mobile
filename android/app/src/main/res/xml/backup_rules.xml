<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-backup allow/deny list (Android 11 and lower).
  Shared preferences hold the auth token, so they are excluded from
  backups. Everything else (images, chat history outside prefs) may back up.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    <exclude domain="sharedpref" path="FlutterSecurePreferences.xml" />
</full-backup-content>